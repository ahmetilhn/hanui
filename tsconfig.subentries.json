{
  /* Alt girişlerin tipleri — dosya başına, `build/types/<giriş>`. Ayrıntı: `vite.subentry.ts`. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "build/types",
    /* `@ahmetilhn/hanui` EŞLENMEZ: paketin kendi `exports`u üzerinden derlenmiş ana tiplere çözülür. */
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": ["src/chat", "src/charts", "src/types/scss.d.ts"],
  "exclude": ["src/**/*.test.*"]
}
