{
  "name": "@ahmetilhn/hanui",
  "version": "1.0.2",
  "description": "Accessible, theme-driven React component library built on SCSS Modules. Zero runtime UI dependencies, two built-in themes and a fully overridable design-token contract.",
  "author": "Ahmet ilhan <ahmetilhan.dev@gmail.com>",
  "license": "MIT",
  "publisher": "Ahmet ilhan",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./styles.css": "./build/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetilhn/hanui.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetilhn/hanui/issues"
  },
  "homepage": "https://github.com/ahmetilhn/hanui#readme",
  "keywords": [
    "react",
    "ui",
    "component-library",
    "design-system",
    "scss",
    "css-modules",
    "accessible",
    "a11y",
    "wcag",
    "dark-mode",
    "theming",
    "design-tokens",
    "typescript",
    "headless",
    "modal",
    "combobox",
    "bottom-sheet",
    "data-table"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build",
    "dev": "npm run tokens && vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run tokens && npm run typecheck && npm run lint && npm run test && vite build"
  },
  "peerDependencies": {
    "@ahmetilhn/handy-utils": ">=3.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ahmetilhn/handy-utils": "^3.2.8",
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.83.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.0"
  }
}
