{
  "name": "@ahmetilhn/hanui",
  "version": "2.6.0",
  "description": "Accessible, theme-driven React component library built on SCSS Modules. Bootstrap Icons for shell iconography, two built-in themes and a fully overridable design-token contract.",
  "author": "Ahmet ilhan <ahmetilhan.dev@gmail.com>",
  "license": "MIT",
  "publisher": "Ahmet ilhan",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./styles.css": "./build/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetilhn/hanui.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetilhn/hanui/issues"
  },
  "homepage": "https://github.com/ahmetilhn/hanui#readme",
  "keywords": [
    "react",
    "ui",
    "component-library",
    "design-system",
    "scss",
    "css-modules",
    "accessible",
    "a11y",
    "wcag",
    "dark-mode",
    "theming",
    "design-tokens",
    "typescript",
    "headless",
    "modal",
    "combobox",
    "bottom-sheet",
    "data-table"
  ],
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build",
    "dev": "npm run tokens && vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && stylelint \"src/**/*.scss\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"playground/**/*.{ts,tsx,css}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"playground/**/*.{ts,tsx,css}\" \"__tests__/**/*.{ts,tsx}\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:animations": "node scripts/check-animations.mjs",
    "check:api": "node scripts/check-api.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "playwright test --project=desktop --project=mobile",
    "test:device": "playwright test --project=ios --project=android",
    "test:device:install": "playwright install webkit chromium",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "npm run tokens && vite build --config playground/vite.config.ts",
    "size": "npm run build && size-limit",
    "verify": "npm run tokens && npm run check:contrast && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run check:api && npm run check:animations && size-limit"
  },
  "peerDependencies": {
    "@ahmetilhn/handy-utils": ">=3.2.0",
    "react": ">=18",
    "react-bootstrap-icons": ">=1.11.0",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ahmetilhn/handy-utils": "^3.2.8",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.0.0",
    "sass": "^1.83.4",
    "size-limit": "^13.0.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.0"
  }
}
