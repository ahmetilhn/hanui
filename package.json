  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "tokens": "node scripts/build-palette.mjs && node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build && vite build --config vite.chat.config.ts && vite build --config vite.charts.config.ts && tsc -p tsconfig.subentries.json && node scripts/build-scss.mjs && node scripts/build-exports.mjs --check",
    "dev": "npm run tokens && vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ scripts --max-warnings 0 && stylelint \"src/**/*.scss\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"playground/**/*.{ts,tsx,css}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"playground/**/*.{ts,tsx,css}\" \"__tests__/**/*.{ts,tsx}\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:animations": "node scripts/check-animations.mjs",
    "check:api": "node scripts/check-api.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "playwright test --project=desktop --project=mobile",
    "test:device": "playwright test --project=ios --project=android",
    "test:device:install": "playwright install webkit chromium",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "npm run tokens && vite build --config playground/vite.config.ts",
    "size": "npm run build && size-limit",
    "verify": "npm run check:palette && npm run tokens && npm run check:contrast && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run check:api && npm run check:animations && size-limit",
    "check:palette": "node scripts/build-palette.mjs --check",
    "check:exports": "node scripts/build-exports.mjs --check",
    "exports": "node scripts/build-exports.mjs"
  },
  "peerDependencies": {
    "@handijit/utils": "^1.0.0",
    "react": ">=18",
    "react-bootstrap-icons": ">=1.11.0",
    "react-dom": ">=18"
  },
