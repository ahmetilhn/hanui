    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "magic-string": "^0.30.21",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.0.0",
    "sass": "^1.83.4",
